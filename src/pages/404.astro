---
import ExternalLink from '../components/ExternalLink.astro';
import {messagesFor} from '../i18n/messages';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/page.css';

const locale = 'en' as const;
const messages = messagesFor(locale);
---

<BaseLayout
  title={`${messages.notFoundTitle()} · ${messages.siteTitle()}`}
  description={messages.notFoundMeta()}
  locale={locale}
  ogImageAlt={messages.ogImageAlt()}
>
  <main class="main">
    <section class="content">
      <h1 class="heading">{messages.notFoundTitle()}</h1>
      <p class="text">
        {messages.notFoundBody()}
        {' '}
        <ExternalLink href="/">{messages.notFoundHome()}</ExternalLink>.
      </p>
    </section>
  </main>
</BaseLayout>
