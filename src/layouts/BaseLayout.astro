---
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
import '../styles/global.css';
import {getLocale, type LocalePath, locales} from '../i18n/locales';

type Props = {
  title: string;
  description: string;
  locale: LocalePath;
  ogImageAlt: string;
};

const {title, description, locale, ogImageAlt} = Astro.props;
const localeMeta = getLocale(locale);
const site = Astro.site?.href ?? 'https://josephchow.dev/';
const canonical = new URL(localeMeta.homeHref, site).href;
const ogImage = new URL(`/og/${locale}.png`, site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joseph Chow',
  url: site,
  email: 'contact@josephchow.dev',
  sameAs: [
    'https://github.com/chowjiaming',
    'https://www.linkedin.com/in/chowjiaming/',
  ],
};
---

<!doctype html>
<html lang={localeMeta.htmlLang} data-theme="system">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script is:inline src="/scripts/theme-init.js"></script>
    <meta name="description" content={description}>
    <meta name="author" content="Joseph Chow">
    <meta name="theme-color" content="#fafafa">
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-512.png">

    {locales.map((entry) => (
        <link
          rel="alternate"
          hreflang={entry.hreflang}
          href={new URL(entry.homeHref, site).href}
        />
      ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href}>

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="Joseph Chow">
    <meta property="og:type" content="website">
    <meta property="og:locale" content={localeMeta.ogLocale}>
    {locales
        .filter((entry) => entry.path !== locale)
        .map((entry) => (
          <meta property="og:locale:alternate" content={entry.ogLocale} />
        ))}
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={ogImageAlt}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:creator" content="@chowjiaming">
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogImageAlt}>

    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
    <style is:global>
      body {
        font-family:
          "Fira Code", "PingFang SC", "PingFang TC", "Noto Sans SC",
          "Noto Sans TC", "Microsoft YaHei", ui-monospace, monospace;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
