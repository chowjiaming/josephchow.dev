{
  "name": "personal-one-pager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:build": "pnpm build && vitest run tests/splash-build.test.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "commit": "lint-staged && pretty-quick --staged",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{json,md,html,css,ts,astro}": "prettier --check"
  },
  "dependencies": {
    "astro": "^5.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
