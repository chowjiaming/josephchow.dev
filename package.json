{
  "name": "josephchow-dev",
  "version": "0.2.0",
  "private": true,
  "description": "Personal site for Joseph Chow (josephchow.dev)",
  "homepage": "https://josephchow.dev",
  "license": "MIT",
  "author": "Joseph Chow <contact@josephchow.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chowjiaming/josephchow.dev.git"
  },
  "bugs": {
    "url": "https://github.com/chowjiaming/josephchow.dev/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "compile:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "generate:og": "node scripts/generate-og.mjs",
    "build": "pnpm compile:i18n && pnpm generate:og && astro check && astro build",
    "preview": "astro preview",
    "typecheck": "pnpm compile:i18n && astro check",
    "test": "vitest run",
    "test:build": "pnpm build && vitest run tests/splash-build.test.ts tests/locale-negotiate.test.ts",
    "test:a11y": "node scripts/a11y.mjs",
    "test:lhci": "lhci autorun",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky && pnpm compile:i18n"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/fira-code": "^5.3.0",
    "@inlang/paraglide-js": "^2.22.0",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.0",
    "@lhci/cli": "^0.15.1",
    "@netlify/edge-functions": "^3.0.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.1",
    "axe-core": "^4.12.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "satori": "^0.29.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
